#!/usr/bin/env python3
"""Worktrees for YouTrack tickets, through worktrunk.

  wt-ticket repos IT-1234          JSON: repos, ones with a branch for the ticket first
  wt-ticket start REPO IT-1234 "summary" [--branch B]
                                   JSON {path, branch, created}: reuses the ticket's branch
                                   if one exists, else makes YYYY/MM/IT-1234/<slug> off origin's default
"""
import datetime as dt
import json
import re
import subprocess
import sys
import unicodedata
from pathlib import Path

ROOT = Path.home() / "durchblicker"


def git(repo, *args, check=False):
    r = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True, timeout=180)
    if check and r.returncode != 0:
        sys.exit(json.dumps({"error": r.stderr.strip() or f"git {' '.join(args)} failed"}))
    return r.stdout.strip()


def ticket_branches(repo, ticket):
    refs = git(repo, "for-each-ref", "--format=%(refname:short)", "refs/heads", "refs/remotes/origin").splitlines()
    pat = re.compile(rf"(^|[/_-]){re.escape(ticket)}([/_-]|$)", re.I)
    out = []
    for r in refs:
        name = r.removeprefix("origin/")
        if pat.search(name) and name not in out and name != "HEAD":
            out.append(name)
    return out


def repos(ticket):
    rows = []
    for d in sorted(ROOT.iterdir()):
        if not (d / ".git").is_dir():
            continue
        idx = d / ".git" / "index"
        rows.append({"repo": d.name, "path": str(d), "branches": ticket_branches(d, ticket),
                     "used": idx.stat().st_mtime if idx.exists() else 0})
    rows.sort(key=lambda r: (not r["branches"], -r["used"]))
    print(json.dumps(rows))


def slug(text):
    text = text.replace("ä", "ae").replace("ö", "oe").replace("ü", "ue").replace("ß", "ss")
    text = text.replace("Ä", "Ae").replace("Ö", "Oe").replace("Ü", "Ue")
    text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode().lower()
    text = re.sub(r"\[[^\]]*\]", " ", text)
    words = re.sub(r"[^a-z0-9]+", " ", text).split()
    out = ""
    for w in words:
        if len(out) + len(w) + 1 > 40:
            break
        out = f"{out}-{w}" if out else w
    return out or "work"


def worktree_for(repo, branch):
    path = None
    for line in git(repo, "worktree", "list", "--porcelain").splitlines():
        if line.startswith("worktree "):
            path = line[9:]
        elif line == f"branch refs/heads/{branch}":
            return path
    return None


def start(repo_name, ticket, summary, branch=None):
    repo = ROOT / repo_name
    if not (repo / ".git").is_dir() or not re.fullmatch(r"[A-Za-z][A-Za-z0-9]+-\d+", ticket):
        sys.exit(json.dumps({"error": "unknown repo or ticket"}))
    git(repo, "fetch", "--quiet", "--prune", "origin", check=True)
    existing = ticket_branches(repo, ticket)
    branch = branch or (existing[0] if existing else None)
    created = branch is None
    if created:
        branch = f"{dt.date.today():%Y/%m}/{ticket.upper()}/{slug(summary)}"
    path = worktree_for(repo, branch)
    if not path:
        default = git(repo, "symbolic-ref", "--short", "refs/remotes/origin/HEAD").removeprefix("origin/") or "main"
        if created:
            cmd = ["wt", "-C", str(repo), "switch", "--create", branch, "--base", f"origin/{default}", "--no-cd", "--yes"]
        else:
            cmd = ["wt", "-C", str(repo), "switch", branch, "--no-cd", "--yes"]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
        if r.returncode != 0:
            sys.exit(json.dumps({"error": (r.stderr.strip() or r.stdout.strip()).splitlines()[-1]}))
        if created:
            git(repo, "branch", "--unset-upstream", branch)
        path = worktree_for(repo, branch)
    if not path:
        sys.exit(json.dumps({"error": f"worktree for {branch} not found after switch"}))
    print(json.dumps({"path": path, "branch": branch, "created": created}))


if __name__ == "__main__":
    a = sys.argv[1:]
    if len(a) == 2 and a[0] == "repos":
        repos(a[1])
    elif len(a) >= 4 and a[0] == "start":
        start(a[1], a[2], a[3], a[5] if len(a) == 6 and a[4] == "--branch" else None)
    else:
        sys.exit(__doc__)
